# Copy to .env for local overrides. No credentials are needed to start the API.
GAME_APP_NAME=Inside the Game

# template makes no model calls; off disables explanations entirely.
# Set foundry only when ready to make potentially billable Azure calls.
GAME_EXPLANATION_PROVIDER=template
# Azure resource root, not the project endpoint or /models endpoint.
GAME_FOUNDRY_ENDPOINT=
GAME_FOUNDRY_DEPLOYMENT=
GAME_FOUNDRY_API_KEY=
GAME_EXPLANATION_TIMEOUT_SECONDS=10
GAME_EXPLANATION_MAX_CALLS=12
# Wall-clock seconds between requests, per replay connection.
GAME_EXPLANATION_INTERVAL_SECONDS=30

# Both the default AI interpretation timeline and Ask the match use this provider.
# Set foundry to use the Azure credentials above, then restart the local server.
# Azure token usage consumes student credit. gemini remains available for older local setups.
GAME_CHAT_PROVIDER=gemini
# Optional legacy Gemini settings (used only with GAME_CHAT_PROVIDER=gemini).
GAME_GEMINI_API_KEY=
GAME_GEMINI_MODEL=gemini-3.8-flash

# Touchline+ (Phase 2): langgraph = tool-choosing agent (default); maf = original workflow.
GAME_AGENT=langgraph
# gemini | foundry | ollama. The agent supports all three; maf supports gemini and foundry.
# GAME_CHAT_PROVIDER above selects the provider.
GAME_OLLAMA_URL=http://127.0.0.1:11434
GAME_OLLAMA_MODEL=qwen2.5:7b-instruct
GAME_AGENT_MAX_TOOL_ROUNDS=4
GAME_CHAT_TIMEOUT_SECONDS=45

# Touchline+ (Phase 4). Tracing: local JSON lines (empty disables) and optional Langfuse.
GAME_TRACE_LOG=logs/traces.jsonl
GAME_LANGFUSE_PUBLIC_KEY=
GAME_LANGFUSE_SECRET_KEY=
GAME_LANGFUSE_HOST=https://cloud.langfuse.com
# RAG over knowledge/*.md. Build the index with: pipenv run python -m app.rag.ingest
# fastembed downloads a small model once; use hash for fully offline setups.
GAME_RAG_ENABLED=true
GAME_RAG_EMBEDDER=fastembed
GAME_RAG_PATH=data/chroma
# Guardrails and cost control.
GAME_CHAT_RATE_LIMIT=10
GAME_CHAT_RATE_WINDOW_SECONDS=60
GAME_CACHE_TTL_SECONDS=600
GAME_SESSION_BUDGET_USD=0.10
# USD per 1M tokens [input, output]; verify against your provider's price list.
# GAME_MODEL_PRICES={"gemini-3.8-flash": [0.30, 2.50]}
